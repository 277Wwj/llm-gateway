# Explicit local mock demo. Never use this demo key on a public server.
GATEWAY_MODE=mock
GATEWAY_CONFIG=configs/mock.json
GATEWAY_API_KEY=demo-client-key
GATEWAY_RATE_BACKEND=memory
GATEWAY_DEADLINE_SECONDS=15
GATEWAY_QUEUE_TIMEOUT_SECONDS=3
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_BREAKER_MIN_SAMPLES=5
GATEWAY_BREAKER_FAILURE_RATIO=0.5
GATEWAY_BREAKER_WINDOW_SECONDS=30
GATEWAY_BREAKER_COOLDOWN_SECONDS=5
# Redis is explicit and fails closed; never falls back to memory.
GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_REDIS_PREFIX=llmgw
# Real: set mode=real, config=configs/real.json and a private GATEWAY_API_KEY.
# Upstream keys are independent of the client key; put here or export in process environment.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
